<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_channel_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/left_stripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:minHeight="38dp"
        android:background="@color/marvel_red" />

    <TextView
        android:id="@+id/channel_name"
        style="@style/HeroUiText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp"
        android:text="Canal"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/channel_badge"
        style="@style/HeroUiText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_blue"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="105dp"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="Geral"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
